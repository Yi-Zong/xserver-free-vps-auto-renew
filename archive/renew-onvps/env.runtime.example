# Runtime variables for run_xserver_notify.py
# Copy this file to .env.runtime and fill in your real values.

TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id
EMAIL=your_xserver_email
PASSWORD=your_xserver_password
ACCOUNT_LABEL=account-1

# Optional image upload variables
XSERVER_IMAGE_UPLOAD_URL=
XSERVER_IMAGE_UPLOAD_REFERER=
XSERVER_IMAGE_STRATEGY_ID=
