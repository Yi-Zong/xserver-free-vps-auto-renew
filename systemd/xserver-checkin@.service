[Unit]
Description=XServer check-in window (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/xserver/app
ExecStart=/usr/bin/python3 /opt/xserver/app/run_xserver_random_window.py %i
User=root
UMask=0077
EnvironmentFile=/opt/xserver/app/.env.runtime
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=3h
StandardOutput=append:/opt/xserver/logs/xserver_random_window.log
StandardError=append:/opt/xserver/logs/xserver_random_window.log
